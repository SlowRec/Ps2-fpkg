 #include "main.h"
 
+
 using namespace c2d;
 using namespace pemu;
+#if defined(__PS4__) && !defined(PEMU_AUTOBOOT)
+#define PEMU_AUTOBOOT
+#endif
+
+#ifdef PEMU_AUTOBOOT
+#include <fstream>
+#include <map>
+
+// ps2-fpkg: paquete de un solo juego. Si existe /app0/autoboot/rom.txt (nombre de la ROM
+// dentro de /app0/autoboot/), se carga directamente y al salir del juego se cierra la app.
+// /app0/autoboot/options.txt (CLAVE=VALOR) da los ajustes iniciales del juego; se aplican
+// solo la primera vez, después mandan los que el jugador cambie en el menú.
+#ifndef AUTOBOOT_DIR
+#define AUTOBOOT_DIR "/app0/autoboot/"
+#endif
+
+static std::string autobootRom() {
+    std::ifstream f(AUTOBOOT_DIR "rom.txt");
+    std::string name;
+    if (!f || !std::getline(f, name)) return {};
+    while (!name.empty() && (name.back() == '\r' || name.back() == '\n' || name.back() == ' ')) name.pop_back();
+    return name.empty() ? std::string() : std::string(AUTOBOOT_DIR) + name;
+}
+
+static void autobootDefaults(PEMUConfig *cfg) {
+    static const std::map<std::string, int> ids = {
+        {"SCALING", PEMUConfig::EMU_SCALING},
+        {"SCALING_MODE", PEMUConfig::EMU_SCALING_MODE},
+        {"FILTER", PEMUConfig::EMU_FILTER},
+        {"EFFECT", PEMUConfig::EMU_SHADER},
+        {"AUDIO_SYNC", PEMUConfig::EMU_AUDIO_SYNC},
+        {"SHOW_FPS", PEMUConfig::EMU_SHOW_FPS},
+    };
+    std::ifstream f(AUTOBOOT_DIR "options.txt");
+    std::string line;
+    while (f && std::getline(f, line)) {
+        while (!line.empty() && (line.back() == '\r' || line.back() == ' ')) line.pop_back();
+        const auto eq = line.find('=');
+        if (eq == std::string::npos) continue;
+        const auto id = ids.find(line.substr(0, eq));
+        if (id == ids.end()) continue;
+        if (auto *opt = cfg->get(id->second, true)) {
+            opt->setArrayIndex(line.substr(eq + 1));
+        }
+    }
+    cfg->saveGame();
+}
+#endif
 
 PEMUUiMain *pemu_ui;
 
